# security-toolkit şablonundan üretildi — değiştirmek için `copier recopy -a .security-toolkit-answers.yml --defaults --overwrite --trust` kullanın.
name: security

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "17 3 * * 1"
  workflow_dispatch:

concurrency:
  group: security-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  scan:
    uses: {{ github_owner }}/security-toolkit/.github/workflows/security-scan.yml@{{ toolkit_ref }}
    permissions:
      contents: read
      pull-requests: write
      security-events: write
    with:
      fail-on: {{ fail_on }}
      toolkit-ref: {{ toolkit_ref }}
{%- if upload_sarif %}
      upload-sarif: true
{%- endif %}
{%- if defectdojo %}
      defectdojo-product: {{ project_name }}
{%- endif %}
{%- if toolkit_private or defectdojo %}
    secrets:
{%- if toolkit_private %}
      TOOLKIT_TOKEN: {% raw %}${{ secrets.TOOLKIT_TOKEN }}{% endraw %}
{%- endif %}
{%- if defectdojo %}
      DEFECTDOJO_URL: {% raw %}${{ secrets.DEFECTDOJO_URL }}{% endraw %}
      DEFECTDOJO_TOKEN: {% raw %}${{ secrets.DEFECTDOJO_TOKEN }}{% endraw %}
{%- endif %}
{%- endif %}
